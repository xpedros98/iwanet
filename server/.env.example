# Copy to server/.env (never commit .env) and fill in.

# Supabase dashboard → Connect → "Session pooler" connection string (works over IPv4).
# Replace [YOUR-PASSWORD] with the database password you set when creating the project.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres

# Only needed in production (npm start). Any long random string.
SESSION_SECRET=
