{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "typecheck": "tsc -p . --noEmit",
    "seed": "tsx src/seed.ts",
    "reset": "tsx src/seed.ts --reset",
    "layout": "tsx src/layoutCli.ts"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "d3-force-3d": "^3.0.6",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
